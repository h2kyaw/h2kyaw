---
const pathname = Astro.url.pathname;
---

<header class="site-header">
  <div class="container nav-wrap">
    <a href="/" class="brand-link">
      <span>Hein Htet Kyaw</span>
      <span class="brand-badge">Dev Vault</span>
    </a>
    
    <nav>
      <ul class="nav-links">
        <li>
          <a href="/" class={`nav-link ${pathname === '/' ? 'active' : ''}`}>Home</a>
        </li>
        <li>
          <a href="/projects" class={`nav-link ${pathname.startsWith('/projects') ? 'active' : ''}`}>Projects</a>
        </li>
        <li>
          <a href="/notes" class={`nav-link ${pathname.startsWith('/notes') ? 'active' : ''}`}>Notes</a>
        </li>
        <li>
          <a href="/snippets" class={`nav-link ${pathname.startsWith('/snippets') ? 'active' : ''}`}>Snippets</a>
        </li>
        <li>
          <a href="/about" class={`nav-link ${pathname === '/about' ? 'active' : ''}`}>About</a>
        </li>
      </ul>
    </nav>

    <div>
      <a href="https://github.com/h2kyaw" target="_blank" rel="noopener noreferrer" class="github-btn">
        <svg height="16" width="16" viewBox="0 0 16 16" fill="currentColor">
          <path d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9 1.04 1.25.41.48 1.45.38 2.02.26 0 .66.01 1.29.01 1.48 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"></path>
        </svg>
        <span>GitHub</span>
      </a>
    </div>
  </div>
</header>
