---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const typeColors: Record<string, { bg: string; color: string; border: string }> = {
  postmortem: { bg: 'rgba(239, 68, 68, 0.12)', color: '#f87171', border: 'rgba(239, 68, 68, 0.25)' },
  adr: { bg: 'rgba(56, 189, 248, 0.12)', color: '#38bdf8', border: 'rgba(56, 189, 248, 0.25)' },
  feature: { bg: 'rgba(16, 185, 129, 0.12)', color: '#34d399', border: 'rgba(16, 185, 129, 0.25)' },
  benchmark: { bg: 'rgba(245, 158, 11, 0.12)', color: '#fbbf24', border: 'rgba(245, 158, 11, 0.25)' },
};

const docType = entry.data.type?.toLowerCase() || 'log';
const badgeStyle = typeColors[docType] || { bg: 'rgba(255, 255, 255, 0.08)', color: 'var(--text-secondary)', border: 'var(--border-color)' };
---

<Layout title={`${entry.data.title || entry.id} | Engineering Writeup`}>
  <div style="margin-bottom: 2rem;">
    <a href="/projects" style="font-size: 0.9rem; color: var(--text-secondary); text-decoration: none; display: inline-flex; align-items: center; gap: 0.35rem;">
      &larr; Back to all writeups
    </a>
  </div>

  <div style="background-color: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: 12px; padding: 1.75rem; margin-bottom: 2.5rem;">
    <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.75rem; flex-wrap: wrap;">
      {entry.data.project && (
        <span class="badge" style="background: rgba(255, 255, 255, 0.08); color: #fff; border: 1px solid var(--border-color); font-weight: 700;">
          {entry.data.project.toUpperCase()}
        </span>
      )}
      <span class="badge" style={`background: ${badgeStyle.bg}; color: ${badgeStyle.color}; border: 1px solid ${badgeStyle.border};`}>
        {entry.data.type?.toUpperCase() || 'WRITEUP'}
      </span>
      {entry.data.date && (
        <span style="display: inline-flex; align-items: center; gap: 0.35rem; font-size: 0.8rem; color: var(--text-secondary);">
          <Icon name="calendar" size={14} />
          {new Date(entry.data.date).toISOString().split('T')[0]}
        </span>
      )}
      {entry.data.severity && (
        <span style="font-size: 0.75rem; color: #f87171; background: rgba(239, 68, 68, 0.1); padding: 0.15rem 0.5rem; border-radius: 4px; border: 1px solid rgba(239, 68, 68, 0.2);">
          Severity: {entry.data.severity.toUpperCase()}
        </span>
      )}
    </div>

    <h1 style="font-size: 2rem; font-weight: 800; color: #fff; margin-bottom: 0.75rem;">
      {entry.data.title || entry.id}
    </h1>

    {entry.data.summary && (
      <p style="color: var(--text-secondary); font-size: 1.05rem; margin-bottom: 1rem; line-height: 1.6;">
        {entry.data.summary}
      </p>
    )}

    {entry.data.tags && entry.data.tags.length > 0 && (
      <div style="display: flex; flex-wrap: wrap; gap: 0.4rem; padding-top: 0.75rem; border-top: 1px solid var(--border-color);">
        {entry.data.tags.map((tag: string) => (
          <span style="font-size: 0.75rem; color: var(--text-secondary); background: rgba(255,255,255,0.05); padding: 0.2rem 0.5rem; border-radius: 4px;">
            #{tag}
          </span>
        ))}
      </div>
    )}
  </div>

  <article class="prose">
    <Content />
  </article>
</Layout>
